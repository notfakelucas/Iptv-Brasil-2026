in-0928392083/PZjF6XATTZ/34870.mp4"},{"s":1,"e":3,"u":"http://dbonline.tech-cdn.top:80/series/ke-vin-0928392083/PZjF6XATTZ/34871.mp4"}],"b":"https://image.tmdb.org/t/p/w1280/8HuJosgqbFrtaC8IpHM6sl2JZy9.jpg","o":"Vivemos na era em que opiniões rasas e slogans políticos tomam o lugar da história. O fascismo acabou se tornando uma das principais vítimas dessa superficialidade: usado de modo ofensivo, porém, mas raramente estudado em profundidade. História do Fascismo foi produzido para romper isso. Para oferecer ao público brasileiro uma visão clara, documentada e rigorosa sobre o tema."},{"t":"Insight BP","l":"https://image.tmdb.org/t/p/w500/vcRfKl8sYmFRbNPSIkFMr9XmlP3.jpg","eps":[{"s":1,"e":1,"u":"http://dbonline.tech-cdn.top:80/series/ke-vin-0928392083/PZjF6XATTZ/34873.mp4"},{"s":1,"e":2,"u":"http://dbonline.tech-cdn.top:80/series/ke-vin-0928392083/PZjF6XATTZ/34875.mp4"},{"s":1,"e":3,"u":"http://dbonline.tech-cdn.top:80/series/ke-vin-0928392083/PZjF6XATTZ/34876.mp4"},{"s":1,"e":4,"u":"http://dbonline.tech-cdn.top:80/series/ke-vin-0928392083/PZjF6XATTZ/34877.mp4"},{"s":1,"e":5,"u":"http://dbonline.tech-cdn.top:80/series/ke-vin-0928392083/PZjF6XATTZ/34878.mp4"},{"s":1,"e":6,"u":"http://dbonline.tech-cdn.top:80/series/ke-vin-0928392083/PZjF6XATTZ/34880.mp4"},{"s":1,"e":7,"u":"http://dbonline.tech-cdn.top:80/series/ke-vin-0928392083/PZjF6XATTZ/34881.mp4"},{"s":1,"e":8,"u":"http://dbonline.tech-cdn.top:80/series/ke-vin-0928392083/PZjF6XATTZ/34882.mp4"},{"s":1,"e":9,"u":"http://dbonline.tech-cdn.top:80/series/ke-vin-0928392083/PZjF6XATTZ/34884.mp4"},{"s":1,"e":10,"u":"http://dbonline.tech-cdn.top:80/series/ke-vin-0928392083/PZjF6XATTZ/34885.mp4"},{"s":1,"e":11,"u":"http://dbonline.tech-cdn.top:80/series/ke-vin-0928392083/PZjF6XATTZ/34886.mp4"},{"s":2,"e":1,"u":"http://dbonline.tech-cdn.top:80/series/ke-vin-0928392083/PZjF6XATTZ/34887.mp4"},{"s":2,"e":2,"u":"http://dbonline.tech-cdn.top:80/series/ke-vin-0928392083/PZjF6XATTZ/34889.mp4"},{"s":2,"e":3,"u":"http://dbonline.te